{
  "plugin": {
    "name": "MikroTik RouterOS",
    "description": "Configure MikroTik routers from Termix instead of WinBox: interfaces, bridges, IP, firewall, wireless, VPN, routing, system, tools and discovery."
  },
  "nav": {
    "title": "MikroTik",
    "openHost": "Open in MikroTik"
  },
  "permissions": {
    "view": {
      "title": "View MikroTik routers",
      "description": "See every menu of routers you can connect to, with passwords and keys left out."
    },
    "operate": {
      "title": "Operate MikroTik routers",
      "description": "Run ping, traceroute, torch and scans, turn interfaces on and off, renew DHCP and drop sessions. Needs edit access to the host."
    },
    "configure": {
      "title": "Configure MikroTik routers",
      "description": "Add, change, remove, enable, disable and move entries in any menu. Needs edit access to the host."
    },
    "administer": {
      "title": "Administer MikroTik routers",
      "description": "Users, packages and updates, scripts, scheduler, files, backups, services, the CLI, reboot and reset, and seeing secrets. Needs edit access to the host."
    }
  },
  "settings": {
    "enable": {
      "label": "MikroTik router",
      "description": "Mark this host as a MikroTik RouterOS router. It then shows in the MikroTik tool under Tools."
    },
    "transport": {
      "label": "Connect through",
      "description": "Automatic uses the API over the host's SSH connection.",
      "auto": "Automatic",
      "apiTunnel": "API over SSH tunnel (v6 and v7)",
      "restTunnel": "REST over SSH tunnel (v7)",
      "rest": "REST API directly (v7)",
      "api": "API directly, port 8728 or 8729"
    },
    "username": {
      "label": "RouterOS user",
      "description": "The user Termix logs in to RouterOS as. Empty uses this host's SSH username.",
      "placeholder": "termix"
    },
    "password": {
      "label": "RouterOS password",
      "description": "Stored encrypted. Empty uses this host's SSH password."
    },
    "address": {
      "label": "Router address",
      "description": "REST and API directly only. Empty uses this host's address."
    },
    "restScheme": {
      "label": "REST over",
      "description": "HTTPS needs the www-ssl service with a certificate; HTTP the www service.",
      "https": "HTTPS (www-ssl)",
      "http": "HTTP (www)"
    },
    "restPort": {
      "label": "REST port",
      "description": "0 for the service's usual port: 443 for HTTPS, 80 for HTTP."
    },
    "apiTls": {
      "label": "API over TLS",
      "description": "Use the api-ssl service. Directly, it needs the router's CA below."
    },
    "apiPort": {
      "label": "API port",
      "description": "0 for the usual port: 8728, or 8729 with TLS."
    },
    "caCert": {
      "label": "CA certificate",
      "description": "REST and API directly only: the PEM of the CA that signed the router's certificate.",
      "placeholder": "-----BEGIN CERTIFICATE-----"
    }
  },
