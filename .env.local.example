# Copy to .env.local (it is in .gitignore) for `npm run live`, which checks the
# plugin's RouterOS clients against a real router. It only reads.

# The router and a RouterOS user for Termix (group read is enough for the check).
ROS_HOST=192.168.88.1
ROS_USER=termix
ROS_PASSWORD=

# Which ways to try: api, rest, api-tunnel, rest-tunnel (comma separated).
ROS_MODES=api,rest,api-tunnel

# API: 8728, or 8729 with ROS_API_TLS=1.
ROS_API_PORT=8728
ROS_API_TLS=0

# REST (RouterOS 7.1+): https on 443 needs www-ssl with a certificate; http on 80 needs www.
ROS_REST_SCHEME=https
ROS_REST_PORT=443

# SSH for the tunnels; the RouterOS login when left out.
# The tunnels need /ip ssh set forwarding-enabled=local (v7) or yes (v6).
ROS_SSH_PORT=22
# ROS_SSH_USER=
# ROS_SSH_PASSWORD=

# Termix server for `npx termix-plugin dev` (reads these itself). Use the https
# address when the server redirects http to https: the key is dropped on a redirect.
TERMIX_SERVER_URL=https://termix.example.com
TERMIX_API_KEY=tmx_...
